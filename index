    const g=cx.createLinearGradient(0,0,cv.width,cv.height);
    p.pal.forEach((c,i)=>g.addColorStop(i/(p.pal.length-1),c));
    cx.fillStyle=g;cx.fillRect(0,0,cv.width,cv.height);
    for(let i=0;i<2800;i++){cx.fillStyle=`rgba(255,255,255,${Math.random()*.04})`;cx.fillRect(Math.random()*cv.width,Math.random()*cv.height,1,1);}
    for(let k=0;k<3;k++){
