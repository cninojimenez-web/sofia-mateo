<script>
/* ── STARFIELD ── */
(function(){
  const c=document.getElementById('starfield'),ctx=c.getContext('2d');
  let stars=[];
  function resize(){c.width=innerWidth;c.height=innerHeight;}
  function init(){
    stars=[];
    const n=Math.floor(c.width*c.height/3600);
    for(let i=0;i<n;i++) stars.push({x:Math.random()*c.width,y:Math.random()*c.height,r:Math.random()*1.1+.2,a:Math.random(),da:(Math.random()-.5)*.004,sp:Math.random()*.14+.03});
  }
  function draw(){
    ctx.clearRect(0,0,c.width,c.height);
    const dark=document.documentElement.dataset.theme==='light'?false:document.documentElement.dataset.theme==='dark'?true:matchMedia('(prefers-color-scheme:dark)').matches;
    if(!dark){requestAnimationFrame(draw);return;}
    stars.forEach(s=>{
      s.a+=s.da;if(s.a<0||s.a>1)s.da*=-1;
      s.y-=s.sp;if(s.y<-2)s.y=c.height+2;
      ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle=`rgba(232,228,240,${s.a*.75})`;ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  resize();init();draw();
  addEventListener('resize',()=>{resize();init();});
})();

