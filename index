<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Sofía & Mateo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap">

<style>
:root {
  --paper:  #0d0b18;
  --dim:    #1a1629;
  --mist:   rgba(255,255,255,.055);
  --border: rgba(255,255,255,.07);
  --rose:   #e8a4b8;
  --gold:   #c9a96e;
  --sky:    #8ab4d4;
  --sage:   #8abda8;
  --lavender:#b4a8d4;
  --text:   #e8e4f0;
  --muted:  rgba(232,228,240,.42);
  --serif:  'Cormorant Garamond', Georgia, serif;
  --sans:   'DM Sans', system-ui, sans-serif;
  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --paper: #f2eef8; --dim: #e5dff4;
    --mist: rgba(0,0,0,.045); --border: rgba(0,0,0,.08);
    --text: #18132a; --muted: rgba(24,19,42,.42);
    color-scheme: light;
  }
}
:root[data-theme="light"] {
  --paper: #f2eef8; --dim: #e5dff4;
  --mist: rgba(0,0,0,.045); --border: rgba(0,0,0,.08);
  --text: #18132a; --muted: rgba(24,19,42,.42);
  color-scheme: light;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--paper); color: var(--text);
  font-family: var(--sans); font-size: 15px; line-height: 1.6;
  overflow-x: hidden; padding-inline: 20px;
}

#starfield { position:fixed; inset:0; z-index:0; pointer-events:none; }
.horizon {
  position:fixed; bottom:0; left:0; right:0; height:40vh;
  background:linear-gradient(to top,rgba(201,169,110,.11) 0%,rgba(232,164,184,.07) 30%,transparent 100%);
  pointer-events:none; z-index:0;
}

.page {
  position:relative; z-index:1;
  max-width:740px; margin:0 auto;
  padding-block:64px 80px;
  display:flex; flex-direction:column; align-items:center;
}

/* HERO */
.hero { text-align:center; width:100%; margin-bottom:52px; }
.eyebrow { font-size:10px; font-weight:500; letter-spacing:.26em; text-transform:uppercase; color:var(--gold); opacity:.75; margin-bottom:26px; }
.names { font-family:var(--serif); font-size:clamp(58px,13vw,102px); font-weight:300; line-height:.93; letter-spacing:-.01em; text-wrap:balance; margin-bottom:14px; }
.names em { font-style:italic; color:var(--rose); }
.amp { color:var(--gold); font-style:normal; font-size:.68em; }
.tagline { font-family:var(--serif); font-size:clamp(16px,3.2vw,21px); font-weight:300; font-style:italic; color:var(--muted); line-height:1.55; }

.div-line { width:36px; height:1px; background:linear-gradient(to right,transparent,var(--gold),transparent); opacity:.45; margin:0 auto 8px; }

/* TABS */
.tab-nav {
  display:flex; gap:0; width:100%;
  border-bottom:1px solid var(--border);
  margin-bottom:48px; overflow-x:auto; scrollbar-width:none;
}
.tab-nav::-webkit-scrollbar { display:none; }
.tab-btn {
  flex:1; min-width:72px; padding:14px 8px 13px;
  border:none; background:transparent;
  font-family:var(--sans); font-size:10px; font-weight:500;
  letter-spacing:.16em; text-transform:uppercase;
  color:var(--muted); cursor:pointer;
  border-bottom:2px solid transparent; margin-bottom:-1px;
  transition:color .22s, border-color .22s; white-space:nowrap;
}
.tab-btn:hover { color:var(--text); }
.tab-btn.active { color:var(--gold); border-bottom-color:var(--gold); }

.tab-panel { display:none; width:100%; animation:fadeIn .3s ease; }
.tab-panel.active { display:block; }
@keyframes fadeIn { from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;} }

.slabel { font-size:10px; font-weight:500; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); opacity:.7; }

/* ═══ TAB 1 — NOSOTROS ═══ */
.photo-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:48px; }
.pf { border-radius:5px; overflow:hidden; position:relative; background:var(--dim); }
.pf.tall { grid-row:span 2; }
.pf canvas { display:block; width:100%; height:100%; }
.pf-cap { position:absolute; bottom:0; left:0; right:0; padding:10px 12px; background:linear-gradient(transparent,rgba(0,0,0,.58)); font-size:10px; color:rgba(255,255,255,.72); letter-spacing:.04em; }

.letter-box { padding:34px 34px 38px; background:var(--mist); border:1px solid var(--border); border-radius:12px; position:relative; }
.letter-box::before { content:'\201C'; position:absolute; top:-8px; left:26px; font-family:var(--serif); font-size:76px; line-height:1; color:var(--rose); opacity:.2; }
.letter-box p { font-family:var(--serif); font-size:19px; font-weight:300; line-height:1.85; margin-bottom:16px; }
.letter-box p:last-child { margin-bottom:0; }
.letter-box .highlight { color:var(--rose); font-style:italic; }
.letter-sig { margin-top:22px; font-family:var(--serif); font-size:14px; font-style:italic; color:var(--muted); text-align:right; }

/* ═══ TAB 2 — ALMAS (NUEVO) ═══ */
.souls-intro { font-family:var(--serif); font-style:italic; font-size:16px; color:var(--muted); text-align:center; line-height:1.7; margin-bottom:36px; }

.soul-tabs { display:flex; gap:8px; justify-content:center; margin-bottom:32px; }
.soul-btn {
  padding:9px 24px; border-radius:20px;
  border:1px solid var(--border); background:transparent;
  font-family:var(--sans); font-size:11px; font-weight:500;
  letter-spacing:.14em; text-transform:uppercase;
  color:var(--muted); cursor:pointer;
  transition:all .22s;
}
.soul-btn.active { background:var(--mist); border-color:var(--rose); color:var(--rose); }
.soul-btn:hover:not(.active) { border-color:var(--muted); color:var(--text); }

.soul-panel { display:none; }
.soul-panel.active { display:block; }

.soul-card {
  background:var(--mist); border:1px solid var(--border);
  border-radius:16px; padding:28px 28px 32px; margin-bottom:24px;
}

.soul-header {
  display:flex; align-items:center; gap:20px; margin-bottom:28px;
  padding-bottom:22px; border-bottom:1px solid var(--border);
}
.soul-zodiac-big {
  width:72px; height:72px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  font-size:36px; flex-shrink:0;
  border:1px solid var(--border);
}
.soul-name { font-family:var(--serif); font-size:28px; font-weight:300; line-height:1; margin-bottom:4px; }
.soul-birth { font-size:12px; color:var(--muted); letter-spacing:.05em; }

.astro-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:24px; }
.astro-cell {
  padding:14px 16px;
  background:rgba(255,255,255,.025); border:1px solid var(--border);
  border-radius:10px; cursor:pointer;
  transition:border-color .22s, background .22s;
  position:relative; overflow:hidden;
}
.astro-cell:hover { border-color:rgba(201,169,110,.3); background:rgba(201,169,110,.05); }
.astro-cell.revealed { border-color:rgba(201,169,110,.25); }
.astro-lbl { font-size:9px; font-weight:500; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); margin-bottom:5px; }
.astro-symbol { font-size:22px; line-height:1; margin-bottom:3px; }
.astro-val { font-family:var(--serif); font-size:16px; font-weight:300; margin-bottom:2px; }
.astro-deg { font-size:11px; color:var(--muted); font-style:italic; }
.astro-reveal {
  display:none; margin-top:10px; padding-top:10px;
  border-top:1px solid var(--border);
  font-size:12px; color:var(--muted); line-height:1.55;
  font-style:italic;
}
.astro-cell.revealed .astro-reveal { display:block; }
.tap-hint { font-size:10px; color:var(--muted); opacity:.5; text-align:center; margin-top:4px; letter-spacing:.05em; }

.compat-bar-wrap { margin-top:4px; }
.compat-label { font-size:11px; color:var(--muted); margin-bottom:8px; }
.compat-bar { height:4px; border-radius:2px; background:var(--mist); overflow:hidden; margin-bottom:12px; }
.compat-fill { height:100%; border-radius:2px; transition:width 1.2s ease; }
.compat-note { font-family:var(--serif); font-size:15px; font-weight:300; font-style:italic; color:var(--text); line-height:1.6; }

.element-badges { display:flex; gap:8px; flex-wrap:wrap; margin-top:20px; }
.ebadge { padding:6px 14px; border-radius:20px; font-size:11px; letter-spacing:.08em; border:1px solid; }

/* ═══ TAB 3 — UNIVERSO ═══ */
.cosmos-intro { font-family:var(--serif); font-style:italic; font-size:15px; color:var(--muted); text-align:center; margin-bottom:28px; line-height:1.6; }
.u-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(195px,1fr)); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:36px; }
.u-cell { background:var(--paper); padding:22px 20px; display:flex; flex-direction:column; gap:5px; cursor:pointer; transition:background .2s; }
.u-cell:hover { background:var(--mist); }
.u-cell.flipped .u-front { display:none; }
.u-cell.flipped .u-back { display:flex; }
.u-front { display:flex; flex-direction:column; gap:5px; }
.u-back { display:none; flex-direction:column; gap:5px; justify-content:center; min-height:80px; }
.u-back-text { font-size:13px; color:var(--muted); line-height:1.5; font-style:italic; }
.u-icon { font-size:20px; margin-bottom:3px; }
.u-lbl { font-size:10px; font-weight:500; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); }
.u-val { font-family:var(--serif); font-size:19px; font-weight:300; line-height:1.2; }
.u-sub { font-size:11px; color:var(--muted); font-style:italic; }
.flip-hint { font-size:10px; color:var(--muted); opacity:.4; text-align:center; margin-bottom:12px; letter-spacing:.06em; }

.const-wrap { background:var(--mist); border:1px solid var(--border); border-radius:12px; padding:28px; text-align:center; }
.const-title { font-family:var(--serif); font-size:21px; font-weight:300; margin-bottom:4px; }
.const-sub { font-size:12px; color:var(--muted); margin-bottom:20px; letter-spacing:.05em; }
#constCanvas { width:100%; max-width:340px; display:block; margin:0 auto; }

/* zodiac ring */
.zodiac-ring-wrap { margin-top:28px; }
.zr-title { font-family:var(--serif); font-size:19px; font-weight:300; text-align:center; margin-bottom:4px; }
.zr-sub { font-size:12px; color:var(--muted); text-align:center; margin-bottom:16px; }
#zodiacRing { display:block; margin:0 auto; max-width:320px; width:100%; }

/* ═══ TAB 4 — HISTORIA ═══ */
.timeline { position:relative; padding-left:28px; display:flex; flex-direction:column; gap:34px; }
.timeline::before { content:''; position:absolute; left:6px; top:8px; bottom:8px; width:1px; background:linear-gradient(to bottom,var(--gold),var(--rose),transparent); opacity:.32; }
.t-item { position:relative; }
.t-dot { position:absolute; left:-25px; top:6px; width:8px; height:8px; border-radius:50%; background:var(--rose); border:2px solid var(--paper); box-shadow:0 0 10px rgba(232,164,184,.5); }
.t-date { font-size:10px; font-weight:500; letter-spacing:.18em; text-transform:uppercase; color:var(--gold); opacity:.8; margin-bottom:3px; }
.t-ttl { font-family:var(--serif); font-size:22px; font-weight:300; line-height:1.2; margin-bottom:5px; }
.t-body { font-size:14px; color:var(--muted); line-height:1.65; max-width:520px; }

/* ═══ TAB 5 — TIEMPO ═══ */
.counter-hero { text-align:center; margin-bottom:36px; }
.big-days { font-family:var(--serif); font-size:clamp(72px,18vw,130px); font-weight:300; line-height:1; color:var(--text); font-variant-numeric:tabular-nums; }
.big-label { font-size:11px; font-weight:500; letter-spacing:.25em; text-transform:uppercase; color:var(--gold); opacity:.7; margin-top:8px; }
.counter-row { display:flex; justify-content:center; gap:4px; flex-wrap:wrap; margin-bottom:44px; }
.c-unit { display:flex; flex-direction:column; align-items:center; min-width:78px; padding:16px 10px 12px; background:var(--mist); border:1px solid var(--border); border-radius:8px; }
.c-num { font-family:var(--serif); font-size:38px; font-weight:300; line-height:1; font-variant-numeric:tabular-nums; letter-spacing:-.02em; }
.c-lbl { font-size:9px; font-weight:500; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); margin-top:5px; }
.c-sep { align-self:center; font-family:var(--serif); font-size:28px; color:var(--gold); opacity:.35; padding:0 2px; line-height:1; }
.stat-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.stat-box { background:var(--mist); border:1px solid var(--border); border-radius:10px; padding:18px 16px; }
.stat-n { font-family:var(--serif); font-size:clamp(22px,5vw,32px); font-weight:300; color:var(--rose); font-variant-numeric:tabular-nums; line-height:1; margin-bottom:4px; }
.stat-desc { font-size:12px; color:var(--muted); line-height:1.4; }

/* ═══ TAB 6 — SOBRE SELLADO ═══ */
.envelope-wrap { text-align:center; padding:20px 0 10px; }
.env-svg { width:120px; height:auto; margin:0 auto 24px; display:block; }
.locked-msg { font-family:var(--serif); font-size:clamp(17px,3.5vw,21px); font-weight:300; font-style:italic; color:var(--muted); line-height:1.65; max-width:480px; margin:0 auto 28px; }
.open-date-box { display:inline-block; padding:14px 28px; background:var(--mist); border:1px solid var(--border); border-radius:8px; margin-bottom:32px; }
.open-date-label { font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); margin-bottom:5px; }
.open-date-val { font-family:var(--serif); font-size:22px; font-weight:300; color:var(--gold); }
.countdown-sealed { display:flex; justify-content:center; gap:6px; flex-wrap:wrap; margin-bottom:36px; }
.cs-unit { display:flex; flex-direction:column; align-items:center; min-width:64px; padding:12px 8px 10px; background:var(--mist); border:1px solid var(--border); border-radius:8px; }
.cs-num { font-family:var(--serif); font-size:28px; font-weight:300; font-variant-numeric:tabular-nums; line-height:1; }
.cs-lbl { font-size:9px; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); margin-top:4px; }
.sealed-note { font-size:13px; color:var(--muted); font-style:italic; line-height:1.6; max-width:400px; margin:0 auto; }

.footer { text-align:center; font-size:11px; color:var(--muted); letter-spacing:.1em; opacity:.45; margin-top:60px; }

/* RESPONSIVE */
@media (max-width:500px) {
  .photo-grid { grid-template-columns:1fr 1fr; }
  .pf.tall { grid-row:span 1; }
  .letter-box { padding:24px 20px 28px; }
  .letter-box p { font-size:17px; }
  .c-num { font-size:30px; }
  .c-unit { min-width:62px; padding:12px 8px 10px; }
  .stat-row { grid-template-columns:1fr; }
  .tab-btn { padding:12px 6px 11px; font-size:9px; }
  .astro-grid { grid-template-columns:1fr; }
  .soul-header { flex-direction:column; text-align:center; }
}
@media (prefers-reduced-motion:reduce) {
  *{ animation-duration:.01ms!important; transition-duration:.01ms!important; }
}
</style>

<canvas id="starfield"></canvas>
<div class="horizon"></div>

<main class="page">

  <!-- HERO -->
  <header class="hero">
    <div class="eyebrow">Una historia escrita en las estrellas</div>
    <h1 class="names"><em>Sofía</em> <span class="amp">&amp;</span> <em>Mateo</em></h1>
    <p class="tagline">Desde el 14 de febrero de 2025,<br>el universo nos puso en el mismo horizonte.</p>
  </header>

  <!-- TAB NAV -->
  <nav class="tab-nav" role="tablist">
    <button class="tab-btn active" data-tab="t-nosotros" role="tab">Nosotros</button>
    <button class="tab-btn"        data-tab="t-almas"    role="tab">Almas</button>
    <button class="tab-btn"        data-tab="t-universo" role="tab">Universo</button>
    <button class="tab-btn"        data-tab="t-historia" role="tab">Historia</button>
    <button class="tab-btn"        data-tab="t-tiempo"   role="tab">Tiempo</button>
    <button class="tab-btn"        data-tab="t-sobre"    role="tab">Sobre</button>
  </nav>

  <!-- ═══ PANEL 1 — NOSOTROS ═══ -->
  <div id="t-nosotros" class="tab-panel active">
    <div class="div-line"></div>
    <div class="slabel" style="text-align:center;margin-bottom:18px;">Nuestros momentos</div>
    <div class="photo-grid" id="photoGrid"></div>
    <div class="div-line" style="margin-top:8px;margin-bottom:26px;"></div>
    <div class="slabel" style="text-align:center;margin-bottom:20px;">Para ti</div>
    <div class="letter-box">
      <p>No sé exactamente cuándo pasó. No hubo un instante preciso, ni una escena de película. Fue algo más lento, más parecido a la manera en que amanece: sin que nadie lo decida, la oscuridad simplemente deja de serlo.</p>
      <p>Contigo aprendí que hay personas que no irrumpen en tu vida, sino que la expanden. Y desde que llegaste, todo ocupa más espacio, en el buen sentido.</p>
      <p class="highlight">Gracias por quedarte.</p>
    </div>
    <div class="letter-sig">Con todo, Mateo.</div>
  </div>

  <!-- ═══ PANEL 2 — ALMAS ═══ -->
  <div id="t-almas" class="tab-panel">
    <div class="div-line"></div>
    <div class="slabel" style="text-align:center;margin-bottom:10px;">Cartas astrales</div>
    <p class="souls-intro">Dos fechas de nacimiento.<br>Un mismo universo que las guardó cerca.</p>

    <div class="soul-tabs">
      <button class="soul-btn active" data-soul="s-sofia">♀ Sofía</button>
      <button class="soul-btn"        data-soul="s-mateo">♂ Mateo</button>
      <button class="soul-btn"        data-soul="s-compat">✦ Compatibilidad</button>
    </div>

    <!-- SOFÍA -->
    <div id="s-sofia" class="soul-panel active">
      <div class="soul-card">
        <div class="soul-header">
          <div class="soul-zodiac-big" style="background:rgba(232,164,184,.1);border-color:rgba(232,164,184,.25);">♏</div>
          <div>
            <div class="soul-name">Sofía</div>
            <div class="soul-birth">3 de noviembre de 1997 · Medellín</div>
            <div class="element-badges" style="margin-top:8px;">
              <span class="ebadge" style="color:var(--rose);border-color:rgba(232,164,184,.3);background:rgba(232,164,184,.07);">Agua</span>
              <span class="ebadge" style="color:var(--gold);border-color:rgba(201,169,110,.3);background:rgba(201,169,110,.07);">Fijo</span>
            </div>
          </div>
        </div>
        <p class="tap-hint">Toca cada planeta para descubrir su influencia</p>
        <div class="astro-grid">
          <div class="astro-cell" onclick="this.classList.toggle('revealed')">
            <div class="astro-lbl">☀ Sol</div>
            <div class="astro-symbol">♏</div>
            <div class="astro-val">Escorpión</div>
            <div class="astro-deg">10° 47' Escorpión</div>
            <div class="astro-reveal">Profunda, intuitiva y magnética. Cuando ama, lo hace sin reservas y con una intensidad que pocas personas comprenden del todo. Su corazón es un océano.</div>
          </div>
          <div class="astro-cell" onclick="this.classList.toggle('revealed')">
            <div class="astro-lbl">☽ Luna</div>
            <div class="astro-symbol">♓</div>
            <div class="astro-val">Piscis</div>
            <div class="astro-deg">22° 14' Piscis</div>
            <div class="astro-reveal">Sus emociones no conocen límites. Siente el mundo de manera extraordinariamente sensible, casi como si llevara el alma de los demás dentro de la propia.</div>
          </div>
          <div class="astro-cell" onclick="this.classList.toggle('revealed')">
            <div class="astro-lbl">↑ Ascendente</div>
            <div class="astro-symbol">♌</div>
            <div class="astro-val">Leo</div>
            <div class="astro-deg">17° 30' Leo · 6:15 AM</div>
            <div class="astro-reveal">Proyecta calidez y presencia antes de decir una sola palabra. La gente la nota cuando entra a una habitación, aunque ella rara vez lo busque.</div>
          </div>
          <div class="astro-cell" onclick="this.classList.toggle('revealed')">
            <div class="astro-lbl">☿ Mercurio</div>
            <div class="astro-symbol">♏</div>
            <div class="astro-val">Escorpión</div>
            <div class="astro-deg">28° 02' Escorpión</div>
            <div class="astro-reveal">Piensa en capas. Cada palabra que dice tiene una segunda y una tercera lectura. Detecta mentiras con una facilidad que desconcierta.</div>
          </div>
          <div class="astro-cell" onclick="this.classList.toggle('revealed')">
            <div class="astro-lbl">♀ Venus</div>
            <div class="astro-symbol">♐</div>
