    {name:'☀',deg:325,color:'#f9d56e',label:'Sol'},      // 25° Acuario = 300+25=325
    {name:'☽',deg:171,color:'#c8d8e8',label:'Luna'},     // Virgo ~171°
    {name:'☿',deg:338,color:'#b8c8d8',label:'Mercurio'}, // 28° Acuario=328, close
    {name:'♀',deg:15, color:'#e8a4b8',label:'Venus'},    // 15° Aries aprox
    {name:'♂',deg:75, color:'#e87050',label:'Marte'},    // Géminis ~75°
    {name:'♃',deg:55, color:'#c8a870',label:'Júpiter'},  // Tauro ~55°
  ];
  const pR=80;
  planets.forEach(p=>{
    const a=(p.deg/360)*Math.PI*2-Math.PI/2;
    const px=CX+pR*Math.cos(a), py=CY+pR*Math.sin(a);
    // dot
    cx.beginPath();cx.arc(px,py,5,0,Math.PI*2);
    cx.fillStyle=p.color+'cc';cx.fill();
    cx.beginPath();cx.arc(px,py,5,0,Math.PI*2);
    cx.strokeStyle=p.color;cx.lineWidth=1;cx.stroke();
    // line from center
    cx.beginPath();cx.moveTo(CX,CY);cx.lineTo(px,py);
    cx.strokeStyle=p.color+'33';cx.lineWidth=.8;cx.stroke();
    // label
    const lx=CX+(pR+22)*Math.cos(a), ly=CY+(pR+22)*Math.sin(a);
    cx.font='10px "DM Sans",system-ui';cx.fillStyle=p.color+'cc';
    cx.textAlign='center';cx.textBaseline='middle';
    cx.fillText(p.name,lx,ly);
  });

  // center
  cx.beginPath();cx.arc(CX,CY,3,0,Math.PI*2);
  cx.fillStyle='rgba(201,169,110,.6)';cx.fill();

  // caption
  cx.font='10px "DM Sans",system-ui';cx.fillStyle='rgba(232,228,240,.3)';
  cx.textAlign='center';cx.textBaseline='middle';
  cx.fillText('14 · 02 · 2025',CX,CY+22);
})();

