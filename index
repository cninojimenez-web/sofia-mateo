/* ── COUNTERS ── */
const START=new Date('2025-02-14T00:00:00');
const OPEN=new Date('2026-02-14T00:00:00');
function pad(n){return String(n).padStart(2,'0');}

function updateCounters(){
  const now=Date.now();
  const elapsed=Math.max(0,now-START);
  const s=Math.floor(elapsed/1e3),m=Math.floor(s/60),h=Math.floor(m/60),d=Math.floor(h/24);
  const bd=document.getElementById('bigDays');if(bd)bd.textContent=d.toLocaleString('es-CO');
  const cH=document.getElementById('cH');if(cH)cH.textContent=pad(h%24);
  const cM=document.getElementById('cM');if(cM)cM.textContent=pad(m%60);
  const cS=document.getElementById('cS');if(cS)cS.textContent=pad(s%60);
  const sr=document.getElementById('statRow');
  if(sr&&!sr.dataset.built){
    sr.dataset.built='1';
    [
      [Math.floor(h*70*2/1e6).toLocaleString('es-CO')+'M+','Latidos del corazón compartidos'],
      [d.toLocaleString('es-CO'),'Amaneceres desde que nos conocimos'],
      [Math.floor(elapsed/(1e3*60*60*24*365.25)*365).toLocaleString('es-CO'),'Días que ha girado la Tierra'],
      [Math.floor(d*0.7).toLocaleString('es-CO')+'+','Mensajes de buenos días'],
    ].forEach(([n,t])=>{
      const b=document.createElement('div');b.className='stat-box';
      b.innerHTML=`<div class="stat-n">${n}</div><div class="stat-desc">${t}</div>`;
      sr.appendChild(b);
    });
  }
  const toOpen=Math.max(0,OPEN-now);
  const ss=Math.floor(toOpen/1e3),sm=Math.floor(ss/60),sh=Math.floor(sm/60),sdv=Math.floor(sh/24);
  const sDays=document.getElementById('sDays');if(sDays)sDays.textContent=sdv.toLocaleString('es-CO');
  const sH=document.getElementById('sHours');if(sH)sH.textContent=pad(sh%24);
  const sM=document.getElementById('sMins');if(sM)sM.textContent=pad(sm%60);
  const sS=document.getElementById('sSecs');if(sS)sS.textContent=pad(ss%60);
  if(toOpen<=0){
    document.querySelectorAll('#sDays,#sHours,#sMins,#sSecs').forEach(el=>el.textContent='00');
    const note=document.querySelector('.sealed-note');
    if(note)note.textContent='El momento ha llegado. Este sobre es tuyo.';
  }
}
updateCounters();setInterval(updateCounters,1000);
</script>

